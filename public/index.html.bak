<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IncentiveSwift Admin</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#0f1117;--surface:#1a1d27;--surface2:#232736;--border:#2d3248;--text:#e1e4ed;--text2:#8b8fa3;--accent:#a78bfa;--accent2:#c4b5fd;--green:#34d399;--red:#ef4444;--yellow:#fbbf24;--radius:8px}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
input,select,textarea{background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:10px 14px;border-radius:var(--radius);font-size:14px;width:100%}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent)}
button{cursor:pointer;font-size:14px;border:none;border-radius:var(--radius);padding:10px 20px;transition:all .2s}
.btn-primary{background:var(--accent);color:#fff}.btn-primary:hover{background:var(--accent2)}
.btn-secondary{background:var(--surface2);color:var(--text);border:1px solid var(--border)}.btn-secondary:hover{background:var(--border)}
.btn-danger{background:var(--red);color:#fff}
.btn-sm{padding:6px 12px;font-size:12px}
table{width:100%;border-collapse:collapse}
th,td{padding:10px 12px;text-align:left;border-bottom:1px solid var(--border);font-size:13px}
th{color:var(--text2);font-weight:600;text-transform:uppercase;font-size:11px;letter-spacing:.5px}
tr:hover{background:rgba(167,139,250,.04)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;margin-bottom:16px}
.stat-card{padding:20px;text-align:center}
.stat-card .num{font-size:28px;font-weight:700;color:var(--accent)}
.stat-card .label{color:var(--text2);font-size:12px;text-transform:uppercase;margin-top:4px}
.grid-4{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.6);z-index:100;display:flex;align-items:center;justify-content:center}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px;width:90%;max-width:500px;max-height:80vh;overflow-y:auto}
.modal h2{margin-bottom:16px}.modal label{display:block;margin-bottom:4px;color:var(--text2);font-size:12px;margin-top:10px}.modal .actions{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}
#app{display:flex;min-height:100vh}
.sidebar{width:240px;background:var(--surface);border-right:1px solid var(--border);padding:20px 0;flex-shrink:0}
.sidebar .logo{padding:0 20px 20px;font-size:18px;font-weight:700;color:var(--accent);border-bottom:1px solid var(--border);margin-bottom:12px}
.sidebar .user-info{padding:0 20px 16px;font-size:12px;color:var(--text2);border-bottom:1px solid var(--border);margin-bottom:12px}
.sidebar nav a{display:flex;align-items:center;gap:10px;padding:10px 20px;color:var(--text2);font-size:13px;transition:all .2s;border-left:3px solid transparent}
.sidebar nav a:hover,.sidebar nav a.active{color:var(--text);background:rgba(167,139,250,.08);border-left-color:var(--accent)}
.main{flex:1;padding:24px;overflow-x:auto}
.main h1{font-size:22px;margin-bottom:20px}
.main .top-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.loading{text-align:center;padding:40px;color:var(--text2)}
.error{color:var(--red);padding:12px;background:rgba(239,68,68,.1);border-radius:var(--radius);margin-bottom:12px;font-size:13px}
.success{color:var(--green);padding:12px;background:rgba(52,211,153,.1);border-radius:var(--radius);margin-bottom:12px;font-size:13px}
.empty{text-align:center;padding:40px;color:var(--text2);font-size:14px}
#login-page{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px}
.login-box{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:40px;width:100%;max-width:400px}
.login-box h1{text-align:center;margin-bottom:8px;color:var(--accent);font-size:24px}
.login-box p{text-align:center;color:var(--text2);margin-bottom:24px;font-size:13px}
.login-box label{display:block;font-size:12px;color:var(--text2);margin-bottom:4px;margin-top:14px}
.login-box button{width:100%;margin-top:20px}
.badge{display:inline-block;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:600}
.badge-active{background:rgba(52,211,153,.15);color:var(--green)}
.badge-inactive{background:rgba(239,68,68,.15);color:var(--red)}
.badge-pending{background:rgba(251,191,36,.15);color:var(--yellow)}
.nav-divider{height:1px;background:var(--border);margin:8px 12px}
.nav-section-label{font-size:10px;text-transform:uppercase;color:var(--text2);letter-spacing:1px;padding:4px 20px 2px;opacity:.6}
.nav-group.nav-admin{margin-top:4px}
.accordion-toggle{cursor:pointer}
.accordion-sub{display:none;overflow:hidden;transition:max-height .3s ease}
.accordion-sub.open{display:block}
.accordion-sub a{padding-left:36px!important;font-size:12px!important}
.settings-link{border-top:1px solid var(--border);margin-top:4px;padding-top:12px!important}
.modal-lg{max-width:800px!important}
.step-indicator{display:flex;gap:8px;margin-bottom:20px;align-items:center}
.step-dot{padding:6px 14px;border-radius:20px;font-size:12px;background:var(--surface2);color:var(--text2);cursor:pointer;border:1px solid var(--border)}
.step-dot.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.step-dot.done{background:rgba(167,139,250,.15);color:var(--accent);border-color:var(--accent)}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.checkbox-col{width:36px}
.bulk-bar{display:none;padding:8px 12px;background:rgba(167,139,250,.1);border:1px solid var(--accent);border-radius:var(--radius);margin-bottom:12px;align-items:center;gap:8px;font-size:13px}
.pagination{display:flex;gap:8px;justify-content:center;align-items:center;padding:16px 0;font-size:13px}
.pagination button{background:var(--surface2);color:var(--text);padding:6px 12px;border:1px solid var(--border)}
.pagination button:disabled{opacity:.4;cursor:default}
@media(max-width:768px){.sidebar{width:60px;overflow:hidden}.sidebar .logo{font-size:14px;padding:12px 16px}.sidebar nav a{padding:10px 16px;justify-content:center}.sidebar nav a span{display:none}.sidebar .user-info{display:none}.main{padding:16px}}
</style>
</head>
<body>
<div id="login-page" style="display:none">
<div class="login-box">
<h1>🏆 IncentiveSwift</h1>
<p>Engagement & Rewards Admin</p>
<div id="login-error" class="error" style="display:none"></div>
<label>Email</label>
<input type="email" id="login-email" value="swiftsoftware143@yahoo.com">
<label>Password</label>
<input type="password" id="login-password" value="SwiftAdmin2026!">
<button class="btn-primary" onclick="login()">Sign In</button>
</div>
</div>
<div id="app" style="display:none">
<div class="sidebar">
<div class="logo">🏆 IncentiveSwift</div>
<div class="user-info" id="user-info">swiftsoftware143@yahoo.com<br>Admin</div>
<nav id="sidebar-nav">
  <div class="nav-group">
    <a href="#" onclick="showPage('dashboard')" data-page="dashboard" class="active"><span>📊</span><span>Dashboard</span></a>
    <a href="#" onclick="showPage('campaigns')" data-page="campaigns"><span>📢</span><span>Campaigns</span></a>
    <a href="#" onclick="showPage('loyalty')" data-page="loyalty"><span>⭐</span><span>Loyalty</span></a>
    <a href="#" onclick="showPage('entries')" data-page="entries"><span>📝</span><span>Entries</span></a>
    <a href="#" onclick="showPage('raffles')" data-page="raffles"><span>🎲</span><span>Raffles</span></a>
    <a href="#" onclick="showPage('contacts')" data-page="contacts"><span>👥</span><span>Contacts</span></a>
    <a href="#" onclick="showPage('apikeys')" data-page="apikeys"><span>🔑</span><span>API Keys</span></a>
    <a href="#" onclick="showPage('integrations')" data-page="integrations"><span>🔗</span><span>Integrations</span></a>
    <a href="#" onclick="showPage('settings')" data-page="settings" class="settings-link"><span>⚙️</span><span>Settings</span></a>
  </div>
  <div class="nav-divider"></div>
  <div class="nav-group nav-admin">
    <div class="nav-section-label">🔧 ADMIN</div>
    <a href="#" onclick="toggleAccordion('admin-accordion')" class="accordion-toggle"><span>🛡️</span><span>Admin <span style="font-size:10px;opacity:0.6">▸</span></span></a>
    <div id="admin-accordion" class="accordion-sub">
      <a href="#" onclick="showPage('tenants')" data-page="tenants"><span>👥</span><span>Tenants</span></a>
      <a href="#" onclick="showPage('portfolios')" data-page="portfolios"><span>🏢</span><span>Portfolio Co.</span></a>
      <a href="#" onclick="showPage('plans')" data-page="plans"><span>📋</span><span>Plans</span></a>
    </div>
    <a href="#" onclick="toggleAccordion('content-accordion')" class="accordion-toggle"><span>📄</span><span>Content <span style="font-size:10px;opacity:0.6">▸</span></span></a>
    <div id="content-accordion" class="accordion-sub">
      <a href="#" onclick="showPage('seo')" data-page="seo"><span>🔍</span><span>SEO</span></a>
      <a href="#" onclick="showPage('legal')" data-page="legal"><span>⚖️</span><span>Legal Pages</span></a>
    </div>
  </div>
  <div class="nav-divider" style="margin-top:4px"></div>
  <a href="#" onclick="logout()" style="border-top:none;padding-top:8px;margin-top:0"><span>🚪</span><span>Logout</span></a>
</nav>
</div>
<div class="main" id="main-content"></div>
</div>
<script>
const API = window.location.origin + '/api/v1';
let token = localStorage.getItem('inc_token');
let currentUser = null;

function $(id){return document.getElementById(id)}
function show(el){el.style.display=''}
function hide(el){el.style.display='none'}

async function api(path, opts={}){
  const headers={'Content-Type':'application/json'};
  if(token) headers['Authorization']='Bearer '+token;
  const res=await fetch(API+path,{...opts,headers});
  if(res.status===401 && token){token=null;localStorage.removeItem('inc_token');render()}
  const ct=res.headers.get('content-type')||'';
  let data;
  if(ct.includes('json')){data=await res.json()}else{data=await res.text();try{data=JSON.parse(data)}catch(e){}}
  if(!res.ok) throw new Error(data?.message||data?.error||'Request failed');
  return data;
}

async function login(){
  const email=$('login-email').value;
  const password=$('login-password').value;
  hide($('login-error'));
  try{
    const res=await api('/auth/login',{method:'POST',body:JSON.stringify({email,password})});
    token=res.access_token||res.token;
    currentUser=res.user;
    localStorage.setItem('inc_token',token);
    render();
  }catch(e){
    $('login-error').textContent=e.message;
    show($('login-error'));
  }
}

function logout(){
  token=null;currentUser=null;
  localStorage.removeItem('inc_token');
  render();
}

async function loadUser(){
  try{
    const res=await api('/auth/me');
    currentUser=res;
    $('user-info').innerHTML=currentUser.email+'<br>'+(currentUser.role||'User');
  }catch(e){}
}

function render(){
  if(token){
    hide($('login-page'));
    show($('app'));
    loadUser();
    showPage('dashboard');
  }else{
    show($('login-page'));
    hide($('app'));
  }
}

let currentPage='';

async function showPage(page){
  currentPage=page;
  document.querySelectorAll('#sidebar-nav a').forEach(a=>a.classList.toggle('active',a.dataset.page===page));
  // Close accordion sub-menus when a page is selected
  document.querySelectorAll('.accordion-sub.open').forEach(sub=>sub.classList.remove('open'));
  const mc=$('main-content');
  mc.innerHTML='<div class="loading">Loading...</div>';
  const renderers={
    dashboard:renderDashboard,
    campaigns:renderCampaigns,
    loyalty:renderLoyalty,
    entries:renderEntries,
    raffles:renderRaffles,
    contacts:renderContacts,
    apikeys:renderApiKeys,
    integrations:renderIntegrations,
    portfolios:renderPortfolios,
    plans:renderPlans,
    settings:renderSettings,
    tenants:renderTenants,
    seo:renderSeo,
    legal:renderLegal,
  };
  try{
    await renderers[page]();
  }catch(e){
    mc.innerHTML='<div class="error">Failed to load: '+e.message+'</div>';
  }
}

/* ===== DASHBOARD ===== */
async function renderDashboard(){
  let stats;
  try{stats=await api('/dashboard/stats')}catch(e){stats=null}
  let campaigns, raffles;
  try{campaigns=await api('/campaigns')}catch(e){campaigns=[]}
  try{raffles=await api('/raffles')}catch(e){raffles=[]}
  if(!Array.isArray(campaigns))campaigns=campaigns?.data||[];
  if(!Array.isArray(raffles))raffles=raffles?.data||[];
  const mc=$('main-content');
  mc.innerHTML='<h1>📊 Dashboard</h1>'
    +'<div class="grid-4">'
    +  '<div class="card stat-card"><div class="num">'+(campaigns.length||'—')+'</div><div class="label">Campaigns</div></div>'
    +  '<div class="card stat-card"><div class="num">'+(raffles.length||'—')+'</div><div class="label">Raffles</div></div>'
    +  '<div class="card stat-card"><div class="num">'+(stats?.entries||stats?.total_entries||'—')+'</div><div class="label">Entries</div></div>'
    +  '<div class="card stat-card"><div class="num">'+(stats?.reward_claims||0)+'</div><div class="label">Reward Claims</div></div>'
    +'</div>'
    +'<div class="card"><h3 style="margin-bottom:12px">Quick Stats</h3><p class="empty">Real-time campaign performance data will appear here</p></div>';
}

/* ===== SETTINGS (Profile + Password) ===== */
async function renderSettings(){
  const mc=$('main-content');
  mc.innerHTML='<h1>⚙️ Settings</h1>'
    +'<div class="card" style="max-width:500px">'
    +'<h3 style="color:var(--accent);margin-bottom:12px">Profile</h3>'
    +'<label>Display Name</label>'
    +'<input id="settings-name" value="'+esc(currentUser?.name||'')+'" style="margin-bottom:12px">'
    +'<button class="btn-primary" onclick="saveProfile()">Save Profile</button>'
    +'</div>'
    +'<div class="card" style="max-width:500px;margin-top:16px">'
    +'<h3 style="color:var(--accent);margin-bottom:12px">Change Password</h3>'
    +'<label>Current Password</label>'
    +'<input id="cur-pw" type="password" style="margin-bottom:8px">'
    +'<label>New Password</label>'
    +'<input id="new-pw" type="password" style="margin-bottom:8px">'
    +'<label>Confirm New Password</label>'
    +'<input id="confirm-pw" type="password" style="margin-bottom:12px">'
    +'<button class="btn-primary" onclick="changeUserPassword()">Update Password</button>'
    +'</div>';
}

async function saveProfile(){
  const name=$('settings-name').value;
  try{
    const r=await api('/auth/profile',{method:'PUT',body:JSON.stringify({name})});
    currentUser=r.user;
    showToast('Profile saved');
    loadUser();
  }catch(e){showToast(e.message,'error')}
}

async function changeUserPassword(){
  const cur=$('cur-pw').value;
  const npw=$('new-pw').value;
  const cnf=$('confirm-pw').value;
  if(npw!==cnf){showToast('Passwords do not match','error');return}
  if(!npw||npw.length<6){showToast('Password must be at least 6 characters','error');return}
  try{
    await api('/auth/password',{method:'PUT',body:JSON.stringify({current_password:cur,new_password:npw})});
    showToast('Password changed');
    $('cur-pw').value='';$('new-pw').value='';$('confirm-pw').value='';
  }catch(e){showToast(e.message,'error')}
}

/* ===== TENANTS (Super Admin) ===== */
let tenants=[],tenPage=1,tenSearch='',tenSelected=[];

async function renderTenants(){
  try{const r=await api('/admin/tenants');tenants=r.tenants||[]}catch(e){tenants=[]}
  if(!Array.isArray(tenants))tenants=tenants?.data||[];
  renderTenantsTable();
}

function renderTenantsTable(){
  const start=(tenPage-1)*20;
  const filtered=tenants.filter(t=>!tenSearch||(t.name||t.email||'').toLowerCase().includes(tenSearch.toLowerCase()));
  const page=filtered.slice(start,start+20);
  const tp=Math.ceil(filtered.length/20)||1;
  const allSelected=tenSelected.length===page.length&&page.length>0;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>👥 Tenants</h1></div>'
    +'<div class="toolbar">'
    +'<input placeholder="Search tenants..." oninput="tenSearch=this.value;tenPage=1;tenSelected=[];renderTenantsTable()" style="max-width:300px">'
    +'</div>'
    +'<div id="tenants-bulk-bar" class="bulk-bar"></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table>'
    +'<tr><th class="checkbox-col"><input type="checkbox" onchange="document.querySelectorAll(\'.ten-sel\').forEach(c=>c.checked=this.checked);tenSelected=this.checked?page.map(p=>p.id):[];showTenantBulkBar()" '+(allSelected?'checked':'')+'></th>'
    +'<th>Name</th><th>Email</th><th>Plan</th><th>Users</th><th>Actions</th></tr>'
    +page.map(t=>{
      const sel=tenSelected.includes(t.id);
      return '<tr>'
        +'<td><input type="checkbox" class="ten-sel" '+(sel?'checked':'')+' onchange="toggleTenantSelect(\''+t.id+'\',this.checked)"></td>'
        +'<td>'+esc(t.name||'—')+'</td><td>'+esc(t.email||'—')+'</td>'
        +'<td><span class="badge badge-'+(t.plan_name!=='No Plan'?'active':'pending')+'">'+esc(t.plan_name||'No Plan')+'</span></td>'
        +'<td>'+(t.user_count||1)+'</td>'
        +'<td>'
        +'<button class="btn-secondary btn-sm" onclick="showAssignPlan(\''+t.id+'\',\''+esc(t.name||t.email)+'\')" style="margin-right:4px">Assign Plan</button>'
        +'</td></tr>';
    }).join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="tenPage=Math.max(1,tenPage-1);renderTenantsTable()" '+(tenPage<=1?'disabled':'')+'>← Prev</button><span>Page '+tenPage+' of '+tp+'</span><button onclick="tenPage=Math.min(tp,tenPage+1);renderTenantsTable()" '+(tenPage>=tp?'disabled':'')+'>Next →</button></div>';
}

function toggleTenantSelect(id,checked){
  if(checked&&!tenSelected.includes(id))tenSelected.push(id);
  else if(!checked)tenSelected=tenSelected.filter(x=>x!==id);
  showTenantBulkBar();
}

function showTenantBulkBar(){
  const bar=$('tenants-bulk-bar');
  if(!bar)return;
  if(tenSelected.length===0){bar.style.display='none';return}
  bar.style.display='flex';
  bar.innerHTML='<span>'+tenSelected.length+' selected</span>'
    +'<button class="btn-secondary btn-sm" onclick="bulkAssignPlan()">Assign Plan</button>';
}

async function showAssignPlan(accountId,name){
  try{plans=await api('/admin/plans')}catch(e){plans=[]}
  if(!Array.isArray(plans))plans=plans?.plans||[];
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  overlay.innerHTML='<div class="modal" style="max-width:400px"><h2>Assign Plan — '+esc(name)+'</h2>'
    +'<div style="margin-bottom:16px">'
    +(plans.length?plans.map(p=>'<label style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:6px 0;border-bottom:1px solid var(--border)">'
      +'<input type="radio" name="plan-select" value="'+p.id+'">'
      +'<span style="font-weight:600">'+esc(p.name)+'</span>'
      +'<span style="color:var(--text2);font-size:12px;margin-left:auto">$'+Number(p.price_monthly||0).toFixed(2)+'/mo</span>'
      +'</label>'):'<p class="empty">No plans available</p>')
    +'</div>'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="doAssignPlan(this,\''+accountId+'\')">Assign</button></div></div>';
  document.body.appendChild(overlay);
}

async function doAssignPlan(btn,accountId){
  const sel=document.querySelector('input[name="plan-select"]:checked');
  if(!sel){showToast('Select a plan','error');return}
  btn.textContent='Assigning...';btn.disabled=true;
  try{
    await api('/admin/plans/assign',{method:'POST',body:JSON.stringify({plan_id:sel.value,account_id:accountId})});
    showToast('Plan assigned');
    btn.closest('.modal-overlay').remove();
    renderTenants();
  }catch(e){showToast(e.message,'error');btn.textContent='Assign';btn.disabled=false}
}

async function bulkAssignPlan(){
  try{plans=await api('/admin/plans')}catch(e){plans=[]}
  if(!Array.isArray(plans))plans=plans?.plans||[];
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  overlay.innerHTML='<div class="modal" style="max-width:400px"><h2>Bulk Assign Plan ('+tenSelected.length+' tenants)</h2>'
    +'<div style="margin-bottom:16px">'
    +(plans.length?plans.map(p=>'<label style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:6px 0;border-bottom:1px solid var(--border)">'
      +'<input type="radio" name="bulk-plan-select" value="'+p.id+'">'
      +'<span>'+esc(p.name)+'</span></label>'):'<p class="empty">No plans</p>')
    +'</div>'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="doBulkAssignPlan(this)">Assign to All</button></div></div>';
  document.body.appendChild(overlay);
}

async function doBulkAssignPlan(btn){
  const sel=document.querySelector('input[name="bulk-plan-select"]:checked');
  if(!sel){showToast('Select a plan','error');return}
  btn.textContent='Assigning...';btn.disabled=true;
  let ok=0,fail=0;
  for(const id of tenSelected){
    try{await api('/admin/plans/assign',{method:'POST',body:JSON.stringify({plan_id:sel.value,account_id:id})});ok++}
    catch(e){fail++}
  }
  showToast('Assigned to '+ok+' tenants'+(fail?' ('+fail+' failed)':''));
  btn.closest('.modal-overlay').remove();
  tenSelected=[];
  renderTenants();
}

/* ===== SEO Settings ===== */
async function renderSeo(){
  let settings=[];
  try{const r=await api('/settings');settings=r.settings||[]}catch(e){}
  if(!Array.isArray(settings))settings=[];
  const getVal=(key,def='')=>{const s=settings.find(x=>x.key===key);return s?s.value?.toString()||def:def};
  const mc=$('main-content');
  mc.innerHTML='<h1>🔍 SEO Settings</h1>'
    +'<div class="card" style="max-width:600px">'
    +'<label style="margin-top:0">Site Title</label><input id="seo-title" value="'+esc(getVal('seo_title'))+'">'
    +'<label>Meta Description</label><textarea id="seo-desc" rows="3">'+esc(getVal('seo_description'))+'</textarea>'
    +'<label>Meta Keywords (comma-separated)</label><input id="seo-keywords" value="'+esc(getVal('seo_keywords'))+'">'
    +'<div class="actions" style="margin-top:16px">'
    +'<button class="btn-primary" onclick="saveSeoSettings()">Save SEO Settings</button></div></div>';
}

async function saveSeoSettings(){
  const settings=[
    {key:'seo_title',value:$('seo-title').value},
    {key:'seo_description',value:$('seo-desc').value},
    {key:'seo_keywords',value:$('seo-keywords').value},
  ];
  try{
    await api('/settings',{method:'PUT',body:JSON.stringify({settings})});
    showToast('SEO settings saved');
  }catch(e){showToast(e.message,'error')}
}

/* ===== Legal Pages ===== */
async function renderLegal(){
  let settings=[];
  try{const r=await api('/settings');settings=r.settings||[]}catch(e){}
  if(!Array.isArray(settings))settings=[];
  const getVal=(key,def='')=>{const s=settings.find(x=>x.key===key);return s?s.value?.toString()||def:def};
  const mc=$('main-content');
  mc.innerHTML='<h1>⚖️ Legal Pages</h1>'
    +'<div class="card"><h3 style="margin-bottom:8px;color:var(--accent)">Terms of Service</h3>'
    +'<textarea id="legal-tos" rows="8" style="font-family:monospace;font-size:12px">'+esc(getVal('legal_tos'))+'</textarea>'
    +'<div class="actions" style="margin-top:8px"><button class="btn-primary" onclick="saveLegal()">Save</button></div></div>'
    +'<div class="card"><h3 style="margin-bottom:8px;color:var(--accent)">Privacy Policy</h3>'
    +'<textarea id="legal-privacy" rows="8" style="font-family:monospace;font-size:12px">'+esc(getVal('legal_privacy'))+'</textarea>'
    +'<div class="actions" style="margin-top:8px"><button class="btn-primary" onclick="saveLegal()">Save</button></div></div>'
    +'<div class="card"><h3 style="margin-bottom:8px;color:var(--accent)">Cookie Policy</h3>'
    +'<textarea id="legal-cookies" rows="6" style="font-family:monospace;font-size:12px">'+esc(getVal('legal_cookies'))+'</textarea>'
    +'<div class="actions" style="margin-top:8px"><button class="btn-primary" onclick="saveLegal()">Save</button></div></div>';
}

async function saveLegal(){
  const settings=[
    {key:'legal_tos',value:$('legal-tos').value},
    {key:'legal_privacy',value:$('legal-privacy').value},
    {key:'legal_cookies',value:$('legal-cookies').value},
  ];
  try{
    await api('/settings',{method:'PUT',body:JSON.stringify({settings})});
    showToast('Legal pages saved');
  }catch(e){showToast(e.message,'error')}
}

/* ===== CAMPAIGNS ===== */
let campaigns=[],cmpPage=1,cmpSearch='';
async function renderCampaigns(){
  try{campaigns=await api('/campaigns')}catch(e){campaigns=[]}
  if(!Array.isArray(campaigns))campaigns=campaigns?.data||campaigns?.campaigns||[];
  renderCampaignsTable();
}
function renderCampaignsTable(){
  const start=(cmpPage-1)*20;
  const filtered=campaigns.filter(c=>!cmpSearch||(c.name||'').toLowerCase().includes(cmpSearch.toLowerCase()));
  const page=filtered.slice(start,start+20);
  const tp=Math.ceil(filtered.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>📢 Campaigns</h1><button class="btn-primary" onclick="showCampaignForm()">+ New Campaign</button></div>'
    +'<div style="margin-bottom:12px"><input placeholder="Search campaigns..." oninput="cmpSearch=this.value;cmpPage=1;renderCampaignsTable()" style="max-width:300px"></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table>'
    +'<tr><th>Name</th><th>Slug</th><th>Type</th><th>Status</th><th>Entries</th><th>Actions</th></tr>'
    +page.map(c=>'<tr><td>'+esc(c.name||'—')+'</td><td>'+esc(c.slug||'—')+'</td><td>'+esc(c.campaign_type||c.type||'—')+'</td><td><span class="badge badge-'+(c.status==='active'?'active':'inactive')+'">'+esc(c.status||'draft')+'</span></td><td>'+(c.entry_count||c.entries||0)+'</td><td><button class="btn-secondary btn-sm" onclick="editCampaign(\''+(c.id||'')+'\')">Edit</button></td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="cmpPage=Math.max(1,cmpPage-1);renderCampaignsTable()" '+(cmpPage<=1?'disabled':'')+'>← Prev</button><span>Page '+cmpPage+' of '+tp+'</span><button onclick="cmpPage=Math.min(tp,cmpPage+1);renderCampaignsTable()" '+(cmpPage>=tp?'disabled':'')+'>Next →</button></div>';
}
function showCampaignForm(c={}){
  // New campaign: first pick a type
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  const types=[
    {id:'spin_wheel',name:'Spin the Wheel',icon:'🎡',desc:'Users spin for prizes'},
    {id:'raffle',name:'Raffle / Giveaway',icon:'🎲',desc:'Enter to win a drawing'},
    {id:'quiz',name:'Quiz',icon:'📝',desc:'Answer questions for entry'},
    {id:'trivia',name:'Trivia',icon:'🧠',desc:'Test knowledge, earn entries'},
    {id:'social_contest',name:'Social Contest',icon:'📱',desc:'Like/share/follow to enter'},
    {id:'referral',name:'Referral',icon:'👥',desc:'Refer friends for rewards'},
    {id:'points',name:'Points Program',icon:'⭐',desc:'Earn points per action'},
    {id:'checkin',name:'Check-In / Visit',icon:'📍',desc:'Visit a location for entry'},
    {id:'purchase',name:'Purchase Entry',icon:'🛒',desc:'Buy to earn entries'},
    {id:'photo_contest',name:'Photo Contest',icon:'📸',desc:'Submit photos, vote to win'},
    {id:'form',name:'Form Entry',icon:'📋',desc:'Simple form for entry'},
    {id:'custom',name:'Custom',icon:'🔧',desc:'Fully configurable'},
  ];
  overlay.innerHTML='<div class="modal" style="max-width:600px"><h2>Choose Campaign Type</h2>'
    +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">'
    +types.map(t=>'<div onclick="selectCampaignType(\''+t.id+'\')" style="padding:12px;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;transition:all .2s" onmouseover="this.style.borderColor=\'var(--accent)\'" onmouseout="this.style.borderColor=\'\'">'
      +'<div style="font-size:24px;margin-bottom:4px">'+t.icon+'</div>'
      +'<div style="font-weight:600;font-size:13px">'+esc(t.name)+'</div>'
      +'<div style="color:var(--text2);font-size:11px">'+esc(t.desc)+'</div>'
      +'</div>').join('')
    +'</div>'
    +'<div class="actions" style="margin-top:16px"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button></div></div>';
  document.body.appendChild(overlay);
}

function selectCampaignType(type){
  document.querySelectorAll('.modal-overlay').forEach(o=>o.remove());
  showCampaignWizard({campaign_type:type});
}

/* ===== CAMPAIGN WIZARD (Multi-step creation) ===== */
let wizardState={};

function showCampaignWizard(initial){
  wizardState={...initial,step:1,totalSteps:4};
  renderWizardStep();
}

function renderWizardStep(){
  const mc=$('main-content');
  const s=wizardState.step||1;
  const ts=wizardState.totalSteps||4;
  // Remove any existing wizard overlay
  document.querySelectorAll('.modal-overlay').forEach(o=>o.remove());
  // Create inline wizard in main content
  let stepsHtml='<div class="step-indicator">';
  const stepNames=['Setup','Config','Prize Pool','Delivery'];
  for(let i=1;i<=ts;i++){
    stepsHtml+='<span class="step-dot '+(i===s?'active':i<s?'done':'')+'">'+(i<s?'✓':i)+' '+stepNames[i-1]+'</span>';
  }
  stepsHtml+='</div>';
  
  let bodyHtml='';
  if(s===1) bodyHtml=renderWizardStep1();
  else if(s===2) bodyHtml=renderWizardStep2();
  else if(s===3) bodyHtml=renderWizardStep3();
  else if(s===4) bodyHtml=renderWizardStep4();
  
  mc.innerHTML='<h1>📢 New Campaign</h1>'+stepsHtml+'<div class="card">'+bodyHtml+'</div>';
}

function renderWizardStep1(){
  return '<h3 style="margin-bottom:16px">Step 1: Basic Setup</h3>'
    +'<label>Campaign Name</label>'
    +'<input id="wiz-name" value="'+esc(wizardState.name||'')+'" placeholder="My Campaign" style="margin-bottom:12px">'
    +'<label>Description</label>'
    +'<textarea id="wiz-desc" rows="3" style="margin-bottom:12px">'+esc(wizardState.description||'')+'</textarea>'
    +'<div class="actions"><button class="btn-primary" onclick="wizardNext()">Next: Config</button></div>';
}

function renderWizardStep2(){
  const ct=wizardState.campaign_type||'spin_wheel';
  return '<h3 style="margin-bottom:16px">Step 2: Campaign Config</h3>'
    +'<label>Status</label>'
    +'<select id="wiz-status" style="margin-bottom:12px"><option value="draft" '+(wizardState.status!=='active'?'selected':'')+'>Draft</option><option value="active" '+(wizardState.status==='active'?'selected':'')+'>Active</option></select>'
    +'<label>Max Spins Per Day (0 = unlimited)</label>'
    +'<input type="number" id="wiz-max-day" value="'+(wizardState.max_spins_per_day||3)+'" min="0" style="margin-bottom:12px">'
    +'<label>Max Spins Per Campaign</label>'
    +'<input type="number" id="wiz-max-campaign" value="'+(wizardState.max_spins_per_campaign||10)+'" min="0" style="margin-bottom:12px">'
    +'<label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:12px">'
    +'<input type="checkbox" id="wiz-pity" '+(wizardState.pity_enabled?'checked':'')+'> Enable Pity Timer (forced win after losses)'
    +'</label>'
    +'<label>Pity Threshold (losses before forced win)</label>'
    +'<input type="number" id="wiz-pity-threshold" value="'+(wizardState.pity_threshold||5)+'" min="1" style="margin-bottom:12px">'
    +'<div class="actions"><button class="btn-secondary" onclick="wizardPrev()">← Back</button><button class="btn-primary" onclick="wizardNext()">Next: Prize Pool</button></div>';
}

function renderWizardStep3(){
  return '<h3 style="margin-bottom:16px">Step 3: Prize Pool</h3>'
    +'<table id="wiz-prize-table" style="margin-bottom:8px">'
    +'<tr><th>Label</th><th>Color</th><th>Weight %</th><th>Type</th><th>Inventory</th><th></th></tr>'
    +'</table>'
    +'<button class="btn-secondary btn-sm" onclick="addWizardPrize()">+ Add Prize</button>'
    +'<div class="actions" style="margin-top:16px"><button class="btn-secondary" onclick="wizardPrev()">← Back</button><button class="btn-primary" onclick="wizardNext()">Next: Delivery</button></div>';
}

function addWizardPrize(){
  const table=$('wiz-prize-table');
  if(!table)return;
  const i=table.rows.length;
  const tr=document.createElement('tr');
  tr.innerHTML='<td><input type="text" value="Prize" style="width:100px" class="wiz-prize-label"></td>'
    +'<td><input type="color" value="#6b7280" style="width:40px;height:32px;padding:2px" class="wiz-prize-color"></td>'
    +'<td><input type="number" value="10" min="0" max="100" style="width:60px" class="wiz-prize-weight"></td>'
    +'<td><select class="wiz-prize-type">'
    +['coupon','merchandise','lose','points'].map(t=>'<option value="'+t+'" '+(t==='coupon'?'selected':'')+'>'+t+'</option>').join('')+'</select></td>'
    +'<td><input type="number" value="10" min="0" style="width:60px" class="wiz-prize-inv"></td>'
    +'<td><button class="btn-danger btn-sm" onclick="this.closest(\'tr\').remove()">✕</button></td>';
  table.appendChild(tr);
}

function renderWizardStep4(){
  return '<h3 style="margin-bottom:16px">Step 4: Delivery & Post-Spin</h3>'
    +'<label>Prize Delivery Method</label>'
    +'<select id="wiz-delivery-method" style="margin-bottom:12px" onchange="toggleWizDeliveryFields()">'
    +'<option value="none" '+(wizardState.delivery_method==='none'||!wizardState.delivery_method?'selected':'')+'>None</option>'
    +'<option value="email" '+(wizardState.delivery_method==='email'?'selected':'')+'>Email</option>'
    +'<option value="redirect" '+(wizardState.delivery_method==='redirect'?'selected':'')+'>Redirect URL</option>'
    +'</select>'
    +'<div id="wiz-delivery-fields" style="'+(wizardState.delivery_method&&wizardState.delivery_method!=='none'?'':'display:none')+'">'
    +'<label id="wiz-delivery-subj-label">'+(wizardState.delivery_method==='email'?'Email Subject':'Redirect URL')+'</label>'
    +'<input id="wiz-delivery-subj" value="'+esc(wizardState.delivery_subj||'')+'" style="margin-bottom:12px">'
    +'<label>Message / Body</label>'
    +'<textarea id="wiz-delivery-body" rows="2" style="margin-bottom:12px">'+esc(wizardState.delivery_body||'')+'</textarea>'
    +'</div>'
    +'<label>Win Redirect URL (optional)</label>'
    +'<input id="wiz-win-url" value="'+esc(wizardState.win_url||'')+'" style="margin-bottom:12px">'
    +'<label>Loss Redirect URL (optional)</label>'
    +'<input id="wiz-lose-url" value="'+esc(wizardState.lose_url||'')+'" style="margin-bottom:12px">'
    +'<div class="actions"><button class="btn-secondary" onclick="wizardPrev()">← Back</button><button class="btn-primary" onclick="wizardSave()">✨ Create Campaign</button></div>';
}

function toggleWizDeliveryFields(){
  const sel=$('wiz-delivery-method');
  const fields=$('wiz-delivery-fields');
  const label=$('wiz-delivery-subj-label');
  if(!sel||!fields)return;
  if(sel.value==='none'){fields.style.display='none';return}
  fields.style.display='block';
  if(label)label.textContent=sel.value==='email'?'Email Subject':'Redirect URL';
}

function wizardPrev(){
  // Save wizard state from fields
  saveWizardFields();
  wizardState.step=Math.max(1,(wizardState.step||1)-1);
  renderWizardStep();
}

function wizardNext(){
  saveWizardFields();
  wizardState.step=Math.min(wizardState.totalSteps||4,(wizardState.step||1)+1);
  renderWizardStep();
}

function saveWizardFields(){
  const s=wizardState.step||1;
  if(s===1){
    wizardState.name=$('wiz-name')?.value||wizardState.name||'';
    wizardState.description=$('wiz-desc')?.value||wizardState.description||'';
  } else if(s===2){
    wizardState.status=$('wiz-status')?.value||'draft';
    wizardState.max_spins_per_day=parseInt($('wiz-max-day')?.value)||0;
    wizardState.max_spins_per_campaign=parseInt($('wiz-max-campaign')?.value)||0;
    wizardState.pity_enabled=$('wiz-pity')?.checked||false;
    wizardState.pity_threshold=parseInt($('wiz-pity-threshold')?.value)||5;
  }
}

async function wizardSave(){
  saveWizardFields();
  if(!wizardState.name){showToast('Campaign name is required','error');return}
  
  // Build prizes from wizard step 3
  const table=$('wiz-prize-table');
  const prizes=[];
  if(table){
    Array.from(table.querySelectorAll('tr')).slice(1).forEach((r,i)=>{
      prizes.push({
        id:'p'+(i+1),
        label:r.querySelector('.wiz-prize-label')?.value||'Prize '+(i+1),
        color:r.querySelector('.wiz-prize-color')?.value||'#6b7280',
        weight:parseInt(r.querySelector('.wiz-prize-weight')?.value)||0,
        prize_type:r.querySelector('.wiz-prize-type')?.value||'coupon',
        inventory:parseInt(r.querySelector('.wiz-prize-inv')?.value)||null,
      });
    });
  }
  if(prizes.length===0)prizes.push({id:'p1',label:'Default Prize',color:'#22c55e',weight:100,prize_type:'coupon',inventory:null});
  
  // Build config
  const config={
    prize_pool:{
      prizes,
      total_weight:prizes.reduce((s,p)=>s+p.weight,0),
      inventory_tracking:true,
      allow_when_exhausted:false,
    },
    pity_timer:{
      enabled:wizardState.pity_enabled||false,
      threshold:wizardState.pity_threshold||5,
    },
    max_spins_per_day:wizardState.max_spins_per_day||3,
    max_spins_per_campaign:wizardState.max_spins_per_campaign||10,
    entry_fields:{first_name:true,last_name:true,email:true,phone:true,website:true,business_name:true},
    delivery:{
      on_win:{redirect:{url:$('wiz-win-url')?.value||'',text:''},autoresponder_fire:false},
      on_lose:{redirect:{url:$('wiz-lose-url')?.value||''}},
    },
  };
  
  const btn=document.querySelector('.actions .btn-primary');
  if(btn){btn.textContent='Creating...';btn.disabled=true}
  
  try{
    // Create campaign
    const typeLabel={spin_wheel:'Spin the Wheel',raffle:'Raffle',quiz:'Quiz',trivia:'Trivia',social_contest:'Social Contest',referral:'Referral',points:'Points',checkin:'Check-In',purchase:'Purchase Entry',photo_contest:'Photo Contest',form:'Form Entry',custom:'Custom'};
    const typeName=typeLabel[wizardState.campaign_type]||'Custom';
    const campaign=await api('/campaigns',{
      method:'POST',
      body:JSON.stringify({
        name: wizardState.name,
        type: wizardState.campaign_type||'spin_wheel',
        tag_namespace: 'default',
        config: config,
      })
    });
    showToast('Campaign "'+wizardState.name+'" created!');
    wizardState={};
    await renderCampaigns();
  }catch(e){
    showToast('Error: '+e.message,'error');
    if(btn){btn.textContent='✨ Create Campaign';btn.disabled=false}
  }
}

function editCampaign(id){
  const c=campaigns.find(x=>x.id===id);
  if(c)showCampaignEditor(c);
}

/* ===== CAMPAIGN EDITOR (Prize Pool / Spin Wheel) ===== */
let editingCampaignId=null;

function showCampaignEditor(campaign){
  editingCampaignId=campaign.id||null;
  const cfg=campaign.config||{};
  const pp=cfg.prize_pool||{prizes:[],total_weight:100,inventory_tracking:false,allow_when_exhausted:false};
  const pt=cfg.pity_timer||{enabled:false,threshold:5};

  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};

  overlay.innerHTML='<div class="modal" style="max-width:700px">'
    +'<h2>'+esc(campaign.name||'New Campaign')+' — Prize Pool Editor</h2>'
    +'<form id="campaign-editor-form">'
    // Prizes section
    +'<div style="margin-bottom:16px">'
    +'<h3 style="margin-bottom:8px;color:var(--accent)">🎁 Prize Pool</h3>'
    +'<table id="prize-table" style="margin-bottom:8px">'
    +'<tr><th>Label</th><th>Color</th><th>Weight %</th><th>Type</th><th>Inventory</th><th></th></tr>'
    +pp.prizes.map((p,i)=>renderPrizeRow(p,i)).join('')
    +'</table>'
    +'<button type="button" class="btn-secondary btn-sm" onclick="addPrizeRow()">+ Add Prize</button>'
    +'</div>'
    // Inventory settings
    +'<div style="margin-bottom:12px;padding:12px;background:var(--surface2);border-radius:var(--radius)">'
    +'<label style="display:flex;align-items:center;gap:8px;cursor:pointer">'
    +'<input type="checkbox" id="inv-tracking" '+(pp.inventory_tracking?'checked':'')+'> Track Inventory'
    +'</label>'
    +'<label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:6px">'
    +'<input type="checkbox" id="allow-exhausted" '+(pp.allow_when_exhausted?'checked':'')+'> Allow Wins When Exhausted'
    +'</label>'
    +'</div>'
    // Pity Timer
    +'<div style="margin-bottom:16px">'
    +'<h3 style="margin-bottom:8px;color:var(--accent)">🔄 Pity Timer</h3>'
    +'<label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px">'
    +'<input type="checkbox" id="pity-enabled" '+(pt.enabled?'checked':'')+'> Enabled'
    +'</label>'
    +'<label style="display:block">Threshold (losses before forced win)'
    +'<input type="number" id="pity-threshold" value="'+(pt.threshold||5)+'" min="1" max="100">'
    +'</label>'
    +'</div>'
    // Max Spins
    +'<div style="margin-bottom:16px">'
    +'<h3 style="margin-bottom:8px;color:var(--accent)">⏱️ Spin Limits</h3>'
    +'<label style="display:block">Max Spins Per Day (0 = unlimited)'
    +'<input type="number" id="max-day" value="'+(cfg.max_spins_per_day||3)+'" min="0">'
    +'</label>'
    +'<label style="display:block;margin-top:8px">Max Spins Per Campaign (0 = unlimited)'
    +'<input type="number" id="max-campaign" value="'+(cfg.max_spins_per_campaign||10)+'" min="0">'
    +'</label>'
    +'</div>'
    // Delivery & Integrations
    +'<div style="margin-bottom:16px"><h3 style="margin-bottom:8px;color:var(--accent)">📨 Prize Delivery</h3>'
    // Per-prize delivery configuration
    +'<div id="delivery-section">'
    +'<table style="width:100%;margin-bottom:8px">'
    +'<tr><th>Prize</th><th>Delivery Method</th><th>Subject / Redirect URL</th><th>Message / Body</th></tr>'
    +pp.prizes.map((p,i)=>renderDeliveryRow(p,i)).join('')
    +'</table>'
    +'<p style="color:var(--text2);font-size:11px;margin-bottom:8px">'
    +'Use {{code}} for redemption code, {{prize_label}} for prize name, {{contact_name}} for name.'
    +'</p>'
    +'</div>'
    // Post-spin redirect (win/lose pages)
    +'<div style="padding:12px;background:var(--surface2);border-radius:var(--radius);margin-top:12px">'
    +'<h4 style="color:var(--accent);margin-bottom:8px">🎯 Post-Spin Pages</h4>'
    +'<label style="display:block">Win Redirect URL (leave blank for default)'
    +'<input type="url" id="win-url" value="'+(cfg.delivery?.on_win?.redirect?.url||'')+'" placeholder="https://example.com/you-won">'
    +'</label>'
    +'<label style="display:block;margin-top:6px">Loss Redirect URL'
    +'<input type="url" id="lose-url" value="'+(cfg.delivery?.on_lose?.redirect?.url||'')+'" placeholder="https://example.com/try-again">'
    +'</label>'
    +'<label style="display:block;margin-top:6px">Win Page Custom Text'
    +'<textarea id="win-text" rows="2" placeholder="Congratulations! You won {{prize_label}}! Show code {{code}} to redeem.">'+(cfg.delivery?.on_win?.redirect?.text||'')+'</textarea>'
    +'</label>'
    +'<label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:8px">'
    +'<input type="checkbox" id="fire-autoresponder" '+(cfg.delivery?.on_win?.autoresponder_fire?'checked':'')+'>'
    +'Fire autoresponder on win'
    +'</label>'
    +'</div>'
    +'</div>'
    // Entry Form Fields section
    +'<div style="margin-bottom:16px">'
    +'<h3 style="margin-bottom:8px;color:var(--accent)">📝 Entry Form Fields</h3>'
    +'<p style="color:var(--text2);font-size:11px;margin-bottom:8px">Choose which fields to collect on the entry form.</p>'
    // Standard fields
    +'<div id="entry-standard-fields" style="margin-bottom:12px">'
    +['first_name','last_name','email','phone','website','business_name'].map(f=>{
      const ef=cfg.entry_fields||{};
      const enabled=ef[f]!==false; // default enabled
      const labels={first_name:'First Name',last_name:'Last Name',email:'Email',phone:'Phone',website:'Website',business_name:'Business Name'};
      return '<label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:4px">'
        +'<input type="checkbox" class="entry-field-toggle" data-field="'+f+'" '+(enabled?'checked':'')+'> '
        +labels[f]+'</label>';
    }).join('')
    +'</div>'
    // Custom fields
    +'<div style="margin-bottom:8px">'
    +'<h4 style="color:var(--text2);font-size:13px;margin-bottom:6px">Custom Fields</h4>'
    +'<div id="custom-fields-container">'
    +'</div>'
    +'<button type="button" class="btn-secondary btn-sm" onclick="addCustomFieldRow()">+ Add Custom Field</button>'
    +'</div>'
    +'</div>'
    +'</form>'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="saveCampaignEditor(this)">Save Campaign Config</button></div>'
    +'</div>';
  document.body.appendChild(overlay);

  // Populate custom fields from campaign config or fetch from API
  const campaignObj=campaigns.find(c=>c.id===editingCampaignId);
  const customFields=cfg.custom_fields||[];
  if(customFields.length>0){
    for(let i=0;i<customFields.length;i++){
      addCustomFieldRow(customFields[i],i);
    }
  }
  // Also try to fetch custom fields from API if campaign has an id
  if(campaignObj?.slug){
    api('/campaigns/'+campaignObj.slug+'/custom-fields').then(r=>{
      if(r?.fields&&r.fields.length>0){
        const container=$('custom-fields-container');
        if(container) container.innerHTML='';
        r.fields.forEach((f,i)=>{
          addCustomFieldRow({field_key:f.field_key,field_label:f.field_label,field_type:f.field_type,required:f.required,options:f.options||[]},i);
        });
      }
    }).catch(()=>{});
  }
}

function addCustomFieldRow(data,i){
  if(typeof i==='undefined')i=Date.now();
  const container=$('custom-fields-container');
  if(!container)return;
  const d=data||{};
  const row=document.createElement('div');
  row.className='custom-field-row';
  row.style.cssText='display:flex;gap:8px;align-items:center;margin-bottom:6px;padding:6px;background:var(--surface2);border-radius:var(--radius)';
  const types=['text','email','phone','textarea','select','checkbox'];
  row.innerHTML=''
    +'<input type="text" class="cf-label" value="'+esc(d.field_label||'')+'" placeholder="Field label" style="width:140px;padding:6px 10px;font-size:13px">'
    +'<select class="cf-type" style="width:90px;padding:6px 10px;font-size:13px">'
    +types.map(t=>'<option value="'+t+'" '+(d.field_type===t?'selected':'')+'>'+t+'</option>').join('')
    +'</select>'
    +'<label style="display:flex;align-items:center;gap:4px;font-size:11px;white-space:nowrap;cursor:pointer">'
    +'<input type="checkbox" class="cf-required" '+(d.required?'checked':'')+'> Req'
    +'</label>'
    +'<input type="text" class="cf-options" value="'+esc(Array.isArray(d.options)?d.options.join(', '):d.options||'')+'" placeholder="Options (comma-sep)" style="width:140px;padding:6px 10px;font-size:13px;display:'+(d.field_type==='select'||d.field_type==='checkbox'?'':'none')+'">'
    +'<button type="button" class="btn-danger btn-sm" onclick="this.parentElement.remove()" style="padding:4px 8px;font-size:12px">✕</button>'
  ;
  // Show/hide options field based on type selection
  const typeSel=row.querySelector('.cf-type');
  const optsInp=row.querySelector('.cf-options');
  if(typeSel&&optsInp){
    typeSel.onchange=function(){
      optsInp.style.display=(this.value==='select'||this.value==='checkbox')?'':'none';
    };
    // Also set initial display
    optsInp.style.display=(typeSel.value==='select'||typeSel.value==='checkbox')?'':'none';
  }
  container.appendChild(row);
}

/**
 * Render an entry form for a campaign showing configured fields and custom fields.
 * Returns an HTML string for the form.
 */
function renderEntryForm(campaign,options){
  const opts=options||{};
  const cfg=campaign.config||{};
  const ef=cfg.entry_fields||{};
  const standardFields=['first_name','last_name','email','phone','website','business_name'];
  const labels={first_name:'First Name',last_name:'Last Name',email:'Email',phone:'Phone',website:'Website',business_name:'Business Name'};
  const placeholders={first_name:'John',last_name:'Doe',email:'john@example.com',phone:'(555) 123-4567',website:'https://example.com',business_name:'Acme Inc'};
  
  let html='<div class="entry-form" style="display:flex;flex-direction:column;gap:10px">';
  
  // Standard fields enabled
  for(const f of standardFields){
    if(ef[f]!==false){
      html+='<label style="font-size:12px;color:var(--text2)">'+labels[f]+'</label>'
        +'<input type="'+(f==='email'?'email':f==='website'?'url':'text')+'" class="entry-field" name="'+f+'" placeholder="'+placeholders[f]+'" style="width:100%">';
    }
  }
  
  // Space for custom fields (they'll be loaded dynamically and appended)
  html+='<div id="entry-custom-fields"></div>';
  
  if(opts.showConsent!==false){
    html+='<label style="display:flex;align-items:center;gap:6px;font-size:12px;cursor:pointer;margin-top:8px">'
      +'<input type="checkbox" id="entry-consent" checked> I agree to participate'
      +'</label>';
  }
  
  html+='</div>';
  return html;
}

/**
 * Load custom fields from API and inject into the form container.
 */
async function loadCustomFieldsIntoForm(campaign,containerId){
  try{
    const res=await api('/campaigns/'+campaign.slug+'/custom-fields');
    const fields=res?.fields||[];
    const container=$(containerId)?.querySelector('#entry-custom-fields');
    if(!container)return;
    fields.forEach(f=>{
      const div=document.createElement('div');
      div.style.marginTop='8px';
      const label=document.createElement('label');
      label.style.cssText='font-size:12px;color:var(--text2);display:block;margin-bottom:2px';
      label.textContent=f.field_label+(f.required?' *':'');
      div.appendChild(label);
      let input;
      if(f.field_type==='select'){
        input=document.createElement('select');
        input.className='entry-custom-field';
        input.name='cf_'+f.id;
        input.dataset.fieldKey=f.field_key;
        input.dataset.required=f.required;
        if(f.required)input.required=true;
        const empty=document.createElement('option');
        empty.value='';
        empty.textContent='Select...';
        input.appendChild(empty);
        (f.options||[]).forEach(o=>{
          const opt=document.createElement('option');
          opt.value=o;
          opt.textContent=o;
          input.appendChild(opt);
        });
      } else if(f.field_type==='checkbox'){
        const wrap=document.createElement('div');
        (f.options||[]).forEach(o=>{
          const lbl=document.createElement('label');
          lbl.style.cssText='display:flex;align-items:center;gap:4px;font-size:12px;cursor:pointer;margin-bottom:2px';
          const cb=document.createElement('input');
          cb.type='checkbox';
          cb.className='entry-custom-field';
          cb.name='cf_'+f.id+'[]';
          cb.value=o;
          cb.dataset.fieldKey=f.field_key;
          lbl.appendChild(cb);
          lbl.appendChild(document.createTextNode(' '+o));
          wrap.appendChild(lbl);
        });
        input=wrap;
      } else if(f.field_type==='textarea'){
        input=document.createElement('textarea');
        input.className='entry-custom-field';
        input.name='cf_'+f.id;
        input.dataset.fieldKey=f.field_key;
        input.dataset.required=f.required;
        input.style.cssText='width:100%;padding:8px 10px;background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:var(--radius);font-size:13px;min-height:60px;resize:vertical';
        if(f.required)input.required=true;
      } else {
        input=document.createElement('input');
        input.type=f.field_type==='phone'?'tel':f.field_type||'text';
        input.className='entry-custom-field';
        input.name='cf_'+f.id;
        input.dataset.fieldKey=f.field_key;
        input.dataset.required=f.required;
        input.style.cssText='width:100%;padding:8px 10px;background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:var(--radius);font-size:13px';
        if(f.required)input.required=true;
      }
      if(input&&input.nodeType===Node.ELEMENT_NODE){
        div.appendChild(input);
      }
      container.appendChild(div);
    });
  }catch(e){/* no custom fields or error */}
}

/**
 * Collect entry form data into an object suitable for the entry API.
 */
function collectEntryFormData(formContainerId){
  const container=$(formContainerId)||document.querySelector('#'+formContainerId);
  if(!container)return{};
  const contact={};
  container.querySelectorAll('.entry-field').forEach(inp=>{
    const val=inp.value.trim();
    if(val)contact[inp.name]=val;
  });
  const answers={};
  container.querySelectorAll('.entry-custom-field').forEach(inp=>{
    if(inp.type==='checkbox'){
      const key=inp.dataset.fieldKey||inp.name;
      if(!answers[key])answers[key]=[];
      if(inp.checked)answers[key].push(inp.value);
    } else {
      const val=inp.value.trim();
      if(val)answers[inp.dataset.fieldKey||inp.name]=val;
    }
  });
  // Also handle multi-checkbox groups from wrapper divs
  container.querySelectorAll('.entry-custom-field[type="checkbox"]').forEach(cb=>{
    const key=cb.dataset.fieldKey;
    if(key&&!answers[key])answers[key]=[];
  });
  return {contact,answers};
}

function renderPrizeRow(p,i){
  const colors=['#22c55e','#3b82f6','#ef4444','#f59e0b','#a855f7','#ec4899','#14b8a6','#6b7280'];
  const c=p.color||colors[i%colors.length];
  return '<tr id="prize-row-'+i+'">'
    +'<td><input type="text" value="'+esc(p.label||'')+'" style="width:100px" data-field="label" data-idx="'+i+'"></td>'
    +'<td><input type="color" value="'+c+'" style="width:40px;height:32px;padding:2px" data-field="color" data-idx="'+i+'"></td>'
    +'<td><input type="number" value="'+(p.weight||0)+'" min="0" max="100" style="width:60px" data-field="weight" data-idx="'+i+'" onchange="normalizeWeights()"></td>'
    +'<td><select data-field="prize_type" data-idx="'+i+'">'
    +['coupon','merchandise','lose','points'].map(t=>'<option value="'+t+'" '+(p.prize_type===t?'selected':'')+'>'+t+'</option>').join('')
    +'</select></td>'
    +'<td><input type="number" value="'+(p.inventory??'')+'" min="0" style="width:60px" placeholder="∞" data-field="inventory" data-idx="'+i+'"></td>'
    +'<td><button type="button" class="btn-danger btn-sm" onclick="removePrizeRow('+i+')">✕</button></td>'
    +'</tr>';
}

function addPrizeRow(){
  const table=$('prize-table');
  const i = table.rows.length - 1; // minus header
  const tr=document.createElement('tr');
  tr.innerHTML=''
    +'<td><input type="text" value="" style="width:100px" data-field="label" data-idx="'+i+'"></td>'
    +'<td><input type="color" value="#6b7280" style="width:40px;height:32px;padding:2px" data-field="color" data-idx="'+i+'"></td>'
    +'<td><input type="number" value="10" min="0" max="100" style="width:60px" data-field="weight" data-idx="'+i+'" onchange="normalizeWeights()"></td>'
    +'<td><select data-field="prize_type" data-idx="'+i+'">'
    +['coupon','merchandise','lose','points'].map(t=>'<option value="'+t+'" '+(t==='coupon'?'selected':'')+'>'+t+'</option>').join('')
    +'</select></td>'
    +'<td><input type="number" value="10" min="0" style="width:60px" placeholder="∞" data-field="inventory" data-idx="'+i+'"></td>'
    +'<td><button type="button" class="btn-danger btn-sm" onclick="removePrizeRow('+i+')">✕</button></td>'
  ;
  const headerRow = table.querySelector('tr');
  table.appendChild(tr);
  normalizeWeights();
}

function removePrizeRow(idx){
  const row=$('prize-row-'+idx);
  if(row)row.remove();
  normalizeWeights();
}

function renderDeliveryRow(p,i){
  const del=p.delivery||{method:'none',subject:'',body:'',redirect_url:''};
  const methods=['none','email','redirect'];
  return '<tr id="delivery-row-'+i+'">'
    +'<td style="font-size:12px">'+esc(p.label||'Prize '+(i+1))+'</td>'
    +'<td><select data-delivery="method" data-idx="'+i+'" onchange="toggleDeliveryFields('+i+')">'
    +methods.map(m=>'<option value="'+m+'" '+(del.method===m?'selected':'')+'>'+m+'</option>').join('')
    +'</select></td>'
    +'<td id="delivery-subj-'+i+'"><input type="text" value="'+(del.method==='email'?esc(del.subject||'You won {{prize_label}}!'):esc(del.redirect_url||''))+'" placeholder="'+(del.method==='email'?'Subject line':'Redirect URL')+'" style="width:180px" data-delivery="subject-or-url" data-idx="'+i+'"></td>'
    +'<td id="delivery-body-'+i+'"><input type="text" value="'+esc(del.body||'')+'" placeholder="Email body / redirect text" style="width:200px" data-delivery="body" data-idx="'+i+'"></td>'
    +'</tr>';
}

function toggleDeliveryFields(idx){
  const sel=document.querySelector('[data-delivery="method"][data-idx="'+idx+'"]');
  if(!sel)return;
  const method=sel.value;
  const subjCell=$('delivery-subj-'+idx);
  const bodyCell=$('delivery-body-'+idx);
  if(!subjCell||!bodyCell)return;
  if(method==='email'){
    subjCell.innerHTML='<input type="text" value="You won {{prize_label}}!" placeholder="Subject line" style="width:180px" data-delivery="subject-or-url" data-idx="'+idx+'">';
    bodyCell.innerHTML='<input type="text" value="" placeholder="Email body" style="width:200px" data-delivery="body" data-idx="'+idx+'">';
  } else if(method==='redirect'){
    subjCell.innerHTML='<input type="url" value="" placeholder="Redirect URL" style="width:180px" data-delivery="subject-or-url" data-idx="'+idx+'">';
    bodyCell.innerHTML='<input type="text" value="" placeholder="Page text (optional)" style="width:200px" data-delivery="body" data-idx="'+idx+'">';
  } else {
    subjCell.innerHTML='<span style="color:var(--text2);font-size:11px">No delivery</span>';
    bodyCell.innerHTML='<span style="color:var(--text2);font-size:11px">—</span>';
  }
}

function normalizeWeights(){
  const table=$('prize-table');
  const rows=Array.from(table.querySelectorAll('tr')).slice(1); // skip header
  let total=0;
  const weights=[];
  rows.forEach((r,i)=>{
    const inp=r.querySelector('[data-field=weight]');
    const w=parseInt(inp.value)||0;
    weights[i]=w;
    total+=w;
  });
  // Show normalized % next to each weight
  // We won't auto-adjust to avoid confusion; just show total
  if(total>0){
    rows.forEach((r,i)=>{
      const inp=r.querySelector('[data-field=weight]');
      const pct=Math.round((weights[i]/total)*100);
      inp.style.setProperty('--after',"' ("+pct+"%)'");
    });
  }
}

function toggleAccordion(id){
  const el=document.getElementById(id);
  if(el)el.classList.toggle('open');
}

async function saveCampaignEditor(btn){
  btn.textContent='Saving...';btn.disabled=true;
  try{
    const table=$('prize-table');
    const rows=Array.from(table.querySelectorAll('tr')).slice(1);
    const prizes=rows.map((r,i)=>{
      return {
        id: 'p'+(i+1),
        label: r.querySelector('[data-field=label]').value || 'Prize '+(i+1),
        color: r.querySelector('[data-field=color]').value,
        weight: parseInt(r.querySelector('[data-field=weight]').value)||0,
        prize_type: r.querySelector('[data-field=prize_type]').value,
        inventory: (function(){const v=r.querySelector('[data-field=inventory]').value;return v===''?null:parseInt(v)})()
      };
    });

    const totalWeight=prizes.reduce((s,p)=>s+p.weight,0);

    // Collect per-prize delivery configs
    const deliveryTable=$('delivery-section');
    const deliveryRows=deliveryTable?Array.from(deliveryTable.querySelectorAll('tr')).slice(1):[];
    const updatedPrizes=prizes.map((p,i)=>{
      const delRow=deliveryRows[i];
      if(delRow){
        const methodEl=delRow.querySelector('[data-delivery="method"]');
        const subjectEl=delRow.querySelector('[data-delivery="subject-or-url"]');
        const bodyEl=delRow.querySelector('[data-delivery="body"]');
        if(methodEl&&methodEl.value!=='none'){
          p.delivery={
            method: methodEl.value,
            subject: methodEl.value==='email'?(subjectEl?.value||'You won {{prize_label}}!'):undefined,
            body: methodEl.value==='email'?(bodyEl?.value||''):undefined,
            redirect_url: methodEl.value==='redirect'?(subjectEl?.value||''):undefined,
          };
        }
      }
      return p;
    });

    // Collect entry field toggles
    const entryFields={};
    document.querySelectorAll('.entry-field-toggle').forEach(cb=>{
      entryFields[cb.dataset.field]=cb.checked;
    });

    // Collect custom fields
    const customFieldRows=document.querySelectorAll('.custom-field-row');
    const customFields=Array.from(customFieldRows).map((row,idx)=>{
      const label=row.querySelector('.cf-label')?.value||'';
      const ftype=row.querySelector('.cf-type')?.value||'text';
      const required=row.querySelector('.cf-required')?.checked||false;
      const options=row.querySelector('.cf-options')?.value||'';
      return {field_key:'cf_'+(idx+1),field_label:label,field_type:ftype,required,options:options.split(',').map(s=>s.trim()).filter(Boolean),sort_order:idx};
    }).filter(cf=>cf.field_label);

    const config={
      prize_pool: {
        prizes: updatedPrizes,
        total_weight: totalWeight,
        inventory_tracking: $('inv-tracking').checked,
        allow_when_exhausted: $('allow-exhausted').checked
      },
      pity_timer: {
        enabled: $('pity-enabled').checked,
        threshold: parseInt($('pity-threshold').value)||5
      },
      max_spins_per_day: parseInt($('max-day').value)||0,
      max_spins_per_campaign: parseInt($('max-campaign').value)||0,
      entry_fields: entryFields,
      custom_fields: customFields,
      delivery: {
        on_win: {
          redirect: {
            url: $('win-url')?.value||'',
            text: $('win-text')?.value||''
          },
          autoresponder_fire: $('fire-autoresponder')?.checked||false
        },
        on_lose: {
          redirect: {
            url: $('lose-url')?.value||''
          }
        }
      }
    };

    if(editingCampaignId){
      const campaign=campaigns.find(c=>c.id===editingCampaignId);
      const slug=campaign?.slug||'';
      await api('/campaigns/'+editingCampaignId,{method:'PUT',body:JSON.stringify({config})});
      // Save custom fields via API
      if(slug){
        // Delete existing custom fields first (simple approach: clear and recreate)
        try{
          const existing=await api('/campaigns/'+slug+'/custom-fields');
          if(existing?.fields){
            for(const f of existing.fields){
              await api('/campaigns/'+slug+'/custom-fields/'+f.id,{method:'DELETE'});
            }
          }
        }catch(ex){/* ok */}
        for(const cf of customFields){
          try{
            await api('/campaigns/'+slug+'/custom-fields',{method:'POST',body:JSON.stringify(cf)});
          }catch(ex){/* skip errors */}
        }
      }
      showToast('Campaign config saved');
    } else {
      showToast('Please create the campaign first, then edit its config','error');
    }
    btn.closest('.modal-overlay')?.remove();
    renderCampaigns();
  }catch(e){
    showToast('Error: '+e.message,'error');
    btn.textContent='Save Campaign Config';btn.disabled=false;
  }
}

/* ===== LOYALTY ===== */
async function renderLoyalty(){
  let rewards;
  try{rewards=await api('/loyalty/rewards')}catch(e){rewards=[]}
  if(!Array.isArray(rewards))rewards=rewards?.data||rewards?.rewards||[];
  const mc=$('main-content');
  mc.innerHTML='<h1>⭐ Loyalty Program</h1>'
    +'<div class="grid-4">'
    +  '<div class="card stat-card"><div class="num">'+(Array.isArray(rewards)?rewards.length:0)+'</div><div class="label">Reward Claims</div></div>'
    +  '<div class="card stat-card"><div class="num">'+rewards.filter(r=>r.status==='pending').length+'</div><div class="label">Pending Approval</div></div>'
    +'</div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table>'
    +'<tr><th>Member</th><th>Points</th><th>Reward</th><th>Status</th><th>Actions</th></tr>'
    +(Array.isArray(rewards)&&rewards.length?rewards.slice(0,50).map(r=>'<tr><td>'+esc(r.member_name||r.member_id?.slice(0,8)||'—')+'</td><td>'+(r.points||0)+'</td><td>'+esc(r.reward_name||r.reward||'—')+'</td><td><span class="badge badge-'+(r.status==='approved'?'active':r.status==='denied'?'inactive':'pending')+'">'+esc(r.status||'pending')+'</span></td><td>'+(r.status==='pending'?'<button class="btn-primary btn-sm" onclick="approveReward(\''+r.id+'\')">Approve</button> <button class="btn-danger btn-sm" onclick="denyReward(\''+r.id+'\')">Deny</button>':'—')+'</td></tr>').join(''):'<tr><td colspan="5" class="empty">No rewards yet</td></tr>')
    +'</table></div>';
}
async function approveReward(id){
  try{await api('/loyalty/rewards/'+id+'/approve',{method:'POST'});showToast('Approved');renderLoyalty();}
  catch(e){showToast(e.message,'error')}
}
async function denyReward(id){
  try{await api('/loyalty/rewards/'+id+'/deny',{method:'POST'});showToast('Denied');renderLoyalty();}
  catch(e){showToast(e.message,'error')}
}

/* ===== ENTRIES ===== */
let entries=[],entPage=1;
async function renderEntries(){
  try{entries=await api('/entries')}catch(e){entries=[]}
  if(!Array.isArray(entries))entries=entries?.data||entries?.entries||[];
  renderEntriesTable();
}
function renderEntriesTable(){
  const start=(entPage-1)*20;
  const page=entries.slice(start,start+20);
  const tp=Math.ceil(entries.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>📝 Entries</h1></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table><tr><th>ID</th><th>Campaign</th><th>Contact</th><th>Status</th><th>Date</th></tr>'
    +page.map(e=>'<tr><td>'+esc(e.id?.slice(0,8)||'—')+'</td><td>'+esc(e.campaign_name||e.campaign?.name||'—')+'</td><td>'+esc(e.contact_name||e.contact?.name||e.email||'—')+'</td><td><span class="badge badge-'+(e.status==='converted'?'active':'pending')+'">'+esc(e.status||'pending')+'</span></td><td>'+(e.created_at?new Date(e.created_at).toLocaleDateString():'—')+'</td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="entPage=Math.max(1,entPage-1);renderEntriesTable()" '+(entPage<=1?'disabled':'')+'>← Prev</button><span>Page '+entPage+' of '+tp+'</span><button onclick="entPage=Math.min(tp,entPage+1);renderEntriesTable()" '+(entPage>=tp?'disabled':'')+'>Next →</button></div>';
}

/* ===== RAFFLES ===== */
let raffles=[],rafPage=1;
async function renderRaffles(){
  try{raffles=await api('/raffles')}catch(e){raffles=[]}
  if(!Array.isArray(raffles))raffles=raffles?.data||[];
  renderRafflesTable();
}
function renderRafflesTable(){
  const start=(rafPage-1)*20;
  const page=raffles.slice(start,start+20);
  const tp=Math.ceil(raffles.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>🎲 Raffles / Giveaways</h1></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table><tr><th>Name</th><th>Slug</th><th>Entries</th><th>Status</th><th>Actions</th></tr>'
    +page.map(r=>'<tr><td>'+esc(r.name||'—')+'</td><td>'+esc(r.slug||'—')+'</td><td>'+(r.entry_count||0)+'</td><td><span class="badge badge-'+(r.status==='active'?'active':'inactive')+'">'+esc(r.status||'draft')+'</span></td><td><button class="btn-primary btn-sm" onclick="drawRaffle(\''+r.slug+'\')">Draw</button></td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="rafPage=Math.max(1,rafPage-1);renderRafflesTable()" '+(rafPage<=1?'disabled':'')+'>← Prev</button><span>Page '+rafPage+' of '+tp+'</span><button onclick="rafPage=Math.min(tp,rafPage+1);renderRafflesTable()" '+(rafPage>=tp?'disabled':'')+'>Next →</button></div>';
}
async function drawRaffle(slug){
  try{const r=await api('/raffles/'+slug+'/draw',{method:'POST'});showToast('Winner drawn: '+(r.winner||'see results'));renderRaffles();}
  catch(e){showToast(e.message,'error')}
}

/* ===== CONTACTS ===== */
let contacts=[],conPage=1,conSearch='';
async function renderContacts(){
  try{contacts=await api('/contacts')}catch(e){contacts=[]}
  if(!Array.isArray(contacts))contacts=contacts?.data||[];
  renderContactsTable();
}
function renderContactsTable(){
  const start=(conPage-1)*20;
  const filtered=contacts.filter(c=>!conSearch||(c.name||c.email||'').toLowerCase().includes(conSearch.toLowerCase()));
  const page=filtered.slice(start,start+20);
  const tp=Math.ceil(filtered.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>👥 Contacts</h1></div>'
    +'<div style="margin-bottom:12px"><input placeholder="Search contacts..." oninput="conSearch=this.value;conPage=1;renderContactsTable()" style="max-width:300px"></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table><tr><th>Name</th><th>Email</th><th>Phone</th><th>Source</th></tr>'
    +page.map(c=>'<tr><td>'+esc(c.name||'—')+'</td><td>'+esc(c.email||'—')+'</td><td>'+esc(c.phone||'—')+'</td><td>'+esc(c.source||'—')+'</td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="conPage=Math.max(1,conPage-1);renderContactsTable()" '+(conPage<=1?'disabled':'')+'>← Prev</button><span>Page '+conPage+' of '+tp+'</span><button onclick="conPage=Math.min(tp,conPage+1);renderContactsTable()" '+(conPage>=tp?'disabled':'')+'>Next →</button></div>';
}

/* ===== API KEYS ===== */
let apikeys=[],akPage=1;
async function renderApiKeys(){
  try{apikeys=await api('/api-keys')}catch(e){apikeys=[]}
  if(!Array.isArray(apikeys))apikeys=apikeys?.data||[];
  renderApiKeysTable();
}
function renderApiKeysTable(){
  const start=(akPage-1)*20;
  const page=apikeys.slice(start,start+20);
  const tp=Math.ceil(apikeys.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>🔑 API Keys</h1><button class="btn-primary" onclick="createApiKey()">+ New Key</button></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table><tr><th>Name</th><th>Key Preview</th><th>Active</th><th>Actions</th></tr>'
    +page.map(k=>'<tr><td>'+esc(k.name||'—')+'</td><td>'+esc((k.key||k.api_key||'').slice(0,12)+'...')+'</td><td><span class="badge badge-'+(!k.revoked?'active':'inactive')+'">'+(!k.revoked?'Active':'Revoked')+'</span></td><td><button class="btn-danger btn-sm" onclick="deleteApiKey(\''+(k.id||'')+'\')">Revoke</button></td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="akPage=Math.max(1,akPage-1);renderApiKeysTable()" '+(akPage<=1?'disabled':'')+'>← Prev</button><span>Page '+akPage+' of '+tp+'</span><button onclick="akPage=Math.min(tp,akPage+1);renderApiKeysTable()" '+(akPage>=tp?'disabled':'')+'>Next →</button></div>';
}
async function createApiKey(){
  const name=prompt('API Key name:');
  if(!name)return;
  try{const r=await api('/api-keys',{method:'POST',body:JSON.stringify({name})});showToast('Key created: '+r.key);renderApiKeys();}
  catch(e){showToast(e.message,'error')}
}
async function deleteApiKey(id){
  if(!confirm('Revoke this API key?'))return;
  try{await api('/api-keys/'+id,{method:'DELETE'});renderApiKeys();showToast('Revoked');}
  catch(e){showToast(e.message,'error')}
}

/* ===== PORTFOLIO COMPANIES ===== */
let portfolioCos=[],pcPage=1,pcSearch='',pcSelected=[];

async function renderPortfolios(){
  try{const r=await api('/portfolio-companies');portfolioCos=r.companies||[]}catch(e){portfolioCos=[]}
  if(!Array.isArray(portfolioCos))portfolioCos=portfolioCos?.data||[];
  renderPortfoliosTable();
}

function renderPortfoliosTable(){
  const start=(pcPage-1)*20;
  const filtered=portfolioCos.filter(c=>!pcSearch||(c.name||c.email||c.slug||'').toLowerCase().includes(pcSearch.toLowerCase()));
  const page=filtered.slice(start,start+20);
  const tp=Math.ceil(filtered.length/20)||1;
  const allSelected=pcSelected.length===page.length&&page.length>0;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>🏢 Portfolio Companies</h1><button class="btn-primary" onclick="showCompanyForm()">+ Add Company</button></div>'
    +'<div class="toolbar">'
    +'<input placeholder="Search companies..." oninput="pcSearch=this.value;pcPage=1;renderPortfoliosTable()" style="max-width:300px">'
    +'</div>'
    +'<div id="pc-bulk-bar" class="bulk-bar"></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table>'
    +'<tr><th class="checkbox-col"><input type="checkbox" onchange="document.querySelectorAll(\'.pc-sel\').forEach(c=>c.checked=this.checked);pcSelected=this.checked?page.map(p=>p.id):[];showPCBulkBar()" '+(allSelected?'checked':'')+'></th>'
    +'<th>Name</th><th>Slug</th><th>Email</th><th>Actions</th></tr>'
    +page.map(c=>{
      const sel=pcSelected.includes(c.id);
      return '<tr>'
        +'<td><input type="checkbox" class="pc-sel" '+(sel?'checked':'')+' onchange="togglePCSelect(\''+c.id+'\',this.checked)"></td>'
        +'<td>'+esc(c.name||'—')+'</td><td>'+esc(c.slug||'—')+'</td><td>'+esc(c.email||'—')+'</td>'
        +'<td><button class="btn-secondary btn-sm" onclick="editCompany(\''+c.id+'\')" style="margin-right:4px">Edit</button>'
        +'<button class="btn-danger btn-sm" onclick="deleteCompany(\''+c.id+'\')">✕</button></td></tr>';
    }).join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="pcPage=Math.max(1,pcPage-1);renderPortfoliosTable()" '+(pcPage<=1?'disabled':'')+'>← Prev</button><span>Page '+pcPage+' of '+tp+'</span><button onclick="pcPage=Math.min(tp,pcPage+1);renderPortfoliosTable()" '+(pcPage>=tp?'disabled':'')+'>Next →</button></div>';
}

function togglePCSelect(id,checked){
  if(checked&&!pcSelected.includes(id))pcSelected.push(id);
  else if(!checked)pcSelected=pcSelected.filter(x=>x!==id);
  showPCBulkBar();
}

function showPCBulkBar(){
  const bar=$('pc-bulk-bar');
  if(!bar)return;
  if(pcSelected.length===0){bar.style.display='none';return}
  bar.style.display='flex';
  bar.innerHTML='<span>'+pcSelected.length+' selected</span>'
    +'<button class="btn-danger btn-sm" onclick="bulkDeleteCompanies()">Delete Selected</button>';
}

async function bulkDeleteCompanies(){
  if(!confirm('Delete '+pcSelected.length+' companies?'))return;
  let ok=0,fail=0;
  for(const id of pcSelected){
    try{await api('/portfolio-companies/'+id,{method:'DELETE'});ok++}
    catch(e){fail++}
  }
  showToast('Deleted '+ok+' companies'+(fail?' ('+fail+' failed)':''));
  pcSelected=[];
  renderPortfolios();
}

async function deleteCompany(id){
  if(!confirm('Delete this portfolio company?'))return;
  try{
    await api('/portfolio-companies/'+id,{method:'DELETE'});
    showToast('Deleted');
    renderPortfolios();
  }catch(e){showToast(e.message,'error')}
}

function showCompanyForm(existing){
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  const data=existing||{name:'',email:'',slug:'',settings:{}};
  const mk=existing?.settings?.marketing_boost_api_key||'';
  overlay.innerHTML='<div class="modal" style="max-width:550px"><h2>'+(existing?'Edit':'New')+' Company</h2>'
    +'<form id="company-form">'
    +'<label>Company Name</label><input name="name" value="'+esc(data.name||'')+'" required>'
    +'<label>Email</label><input name="email" type="email" value="'+esc(data.email||'')+'">'
    +'<label>Slug (optional)</label><input name="slug" value="'+esc(data.slug||'')+'" placeholder="Auto-generated from name">'
    +'<hr style="border-color:var(--border);margin:16px 0">'
    +'<h3 style="color:var(--accent);margin-bottom:8px">🔑 Marketing Boost API</h3>'
    +'<p style="color:var(--text2);font-size:12px;margin-bottom:8px">API credentials used when Marketing Boost integrations fire for this company.</p>'
    +'<label>API Key</label><input name="marketing_boost_api_key" type="password" value="'+esc(mk)+'" placeholder="mb_key_...">'
    +'</form>'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="saveCompany(this,'+!!existing+')">'+esc(existing?'Update':'Create')+'</button></div></div>';
  document.body.appendChild(overlay);
}

async function saveCompany(btn,isEdit){
  const form=btn.closest('.modal').querySelector('#company-form');
  const fd=new FormData(form);
  const mk=fd.get('marketing_boost_api_key')||'';
  btn.textContent='Saving...';btn.disabled=true;
  try{
    const payload={
      name: fd.get('name'),
      email: fd.get('email'),
      slug: fd.get('slug'),
      settings: {}
    };
    if(mk) payload.settings.marketing_boost_api_key=mk;

    if(isEdit){
      await api('/portfolio-companies/'+portEditId,{method:'PUT',body:JSON.stringify(payload)});
      showToast('Company updated');
    } else {
      await api('/portfolio-companies',{method:'POST',body:JSON.stringify(payload)});
      showToast('Company created');
    }
    btn.closest('.modal-overlay').remove();
    renderPortfolios();
  }catch(e){showToast(e.message,'error');btn.textContent=isEdit?'Update':'Create';btn.disabled=false}
}

let portEditId=null;
function editCompany(id){
  const c=portfolioCos.find(x=>x.id===id);
  if(c){portEditId=id;showCompanyForm(c)}
}

/* ===== INTEGRATIONS ===== */
let integrations=[],intPage=1;

async function renderIntegrations(){
  try{integrations=await api('/integration-targets')}catch(e){integrations=[]}
  if(!Array.isArray(integrations))integrations=integrations?.data||[];
  renderIntegrationsTable();
}

function renderIntegrationsTable(){
  const start=(intPage-1)*20;
  const page=integrations.slice(start,start+20);
  const tp=Math.ceil(integrations.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>🔗 Integrations Hub</h1><button class="btn-primary" onclick="showIntegrationForm()">+ New Integration</button></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table><tr><th>Name</th><th>Provider</th><th>Webhook URL</th><th>Status</th><th>Actions</th></tr>'
    +page.map(i=>'<tr><td>'+esc(i.name||'—')+'</td><td>'+esc(i.provider||'—')+'</td><td>'+esc((i.webhook_url||i.url||'').slice(0,30)+'...')+'</td><td><span class="badge badge-'+(!i.disabled?'active':'inactive')+'">'+(!i.disabled?'Active':'Inactive')+'</span></td>'
      +'<td><button class="btn-secondary btn-sm" onclick="editIntegration(\''+(i.id||'')+'\')">Edit</button> '
      +'<button class="btn-danger btn-sm" onclick="deleteIntegration(\''+(i.id||'')+'\')">✕</button></td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="intPage=Math.max(1,intPage-1);renderIntegrationsTable()" '+(intPage<=1?'disabled':'')+'>← Prev</button><span>Page '+intPage+' of '+tp+'</span><button onclick="intPage=Math.min(tp,intPage+1);renderIntegrationsTable()" '+(intPage>=tp?'disabled':'')+'>Next →</button></div>';
}

function showIntegrationForm(existing){
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  const isEdit=!!existing;
  const data=existing||{name:'',provider:'',webhook_url:'',api_key:'',events:['on_win']};
  const providers=['mailgun','sendgrid','sendiio','letterman','nexweave','sam_gov','marketing_boost','webhook'];
  overlay.innerHTML='<div class="modal" style="max-width:550px"><h2>'+(isEdit?'Edit':'New')+' Integration</h2>'
    +'<form id="integration-form">'
    +'<label>Name</label><input name="name" value="'+esc(data.name||'')+'" required>'
    +'<label>Provider</label><select name="provider">'
    +providers.map(p=>'<option value="'+p+'" '+(data.provider===p?'selected':'')+'>'+p+'</option>').join('')
    +'</select>'
    +'<label>Webhook URL</label><input name="webhook_url" type="url" value="'+esc(data.webhook_url||data.url||'')+'" placeholder="https://hooks.example.com/...">'
    +'<label>API Key</label><input name="api_key" type="password" value="'+esc(data.api_key||'')+'" placeholder="Leave blank to keep existing">'
    +'<label>Trigger Events</label>'
    +'<div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:4px">'
    +['on_win','on_loss','on_spin','on_redemption'].map(e=>'<label style="display:flex;align-items:center;gap:4px;font-size:12px;cursor:pointer">'
      +'<input type="checkbox" name="events" value="'+e+'" '+((data.events||[]).includes(e)?'checked':'')+'> '+e+'</label>').join('')
    +'</div>'
    +'</form>'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="saveIntegration(this,'+isEdit+')">'+esc(isEdit?'Update':'Create')+'</button></div></div>';
  document.body.appendChild(overlay);
}

async function saveIntegration(btn,isEdit){
  const form=btn.closest('.modal').querySelector('#integration-form');
  const fd=new FormData(form);
  const data={
    name: fd.get('name'),
    provider: fd.get('provider'),
    webhook_url: fd.get('webhook_url'),
    api_key: fd.get('api_key'),
    events: Array.from(form.querySelectorAll('input[name=events]:checked')).map(e=>e.value)
  };
  btn.textContent='Saving...';btn.disabled=true;
  try{
    await api('/integration-targets',{method:'POST',body:JSON.stringify(data)});
    showToast('Integration '+(isEdit?'updated':'created'));
    btn.closest('.modal-overlay').remove();
    renderIntegrations();
  }catch(e){showToast(e.message,'error');btn.textContent='Save';btn.disabled=false}
}

function editIntegration(id){
  const i=integrations.find(x=>x.id===id);
  if(i)showIntegrationForm(i);
}

async function deleteIntegration(id){
  if(!confirm('Delete this integration?'))return;
  try{await api('/integration-targets/'+id,{method:'DELETE'});showToast('Deleted');renderIntegrations();}
  catch(e){showToast(e.message,'error')}
}

/* ===== PLANS ===== */
let plans=[],plPage=1,plSearch='';
async function renderPlans(){
  try{const r=await api('/admin/plans');plans=r.plans||[]}catch(e){plans=[]}
  if(!Array.isArray(plans))plans=plans?.data||plans?.plans||[];
  renderPlansTable();
}
function renderPlansTable(){
  const start=(plPage-1)*20;
  const filtered=plans.filter(p=>!plSearch||(p.name||'').toLowerCase().includes(plSearch.toLowerCase()));
  const page=filtered.slice(start,start+20);
  const tp=Math.ceil(filtered.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>📋 Plans</h1><button class="btn-primary" onclick="showPlanForm()">+ New Plan</button></div>'
    +'<div style="margin-bottom:12px"><input placeholder="Search plans..." oninput="plSearch=this.value;plPage=1;renderPlansTable()" style="max-width:300px"></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table><tr><th>Name</th><th>Price</th><th>Features</th><th>Status</th><th>Actions</th></tr>'
    +page.map(p=>'<tr><td>'+esc(p.name||'—')+'</td><td>'+(p.price_monthly?'$'+Number(p.price_monthly).toFixed(2):'—')+'</td><td>'+(Array.isArray(p.features)?p.features.length+' features':'—')+'</td><td><span class="badge badge-'+(p.is_active!==false?'active':'inactive')+'">'+(p.is_active!==false?'Active':'Inactive')+'</span></td><td><button class="btn-secondary btn-sm" onclick="editPlan(\''+(p.id||'')+'\')" style="margin-right:4px">Edit</button><button class="btn-danger btn-sm" onclick="deletePlan(\''+(p.id||'')+'\')">✕</button></td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="plPage=Math.max(1,plPage-1);renderPlansTable()" '+(plPage<=1?'disabled':'')+'>← Prev</button><span>Page '+plPage+' of '+tp+'</span><button onclick="plPage=Math.min(tp,plPage+1);renderPlansTable()" '+(plPage>=tp?'disabled':'')+'>Next →</button></div>';
}

async function deletePlan(id){
  if(!confirm('Are you sure you want to delete this plan? This cannot be undone.'))return;
  try{
    await api('/admin/plans/'+id,{method:'DELETE'});
    showToast('Plan deleted');
    renderPlans();
  }catch(e){showToast(e.message,'error')}
}

function showPlanForm(p){
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  const edit=!!p.id;
  overlay.innerHTML='<div class="modal" style="max-width:500px"><h2>'+(edit?'Edit':'New')+' Plan</h2>'
    +'<form id="plan-form">'
    +'<label>Name</label><input name="name" value="'+esc(p.name||'')+'" required>'
    +'<label>Slug</label><input name="slug" value="'+esc(p.slug||'')+'" placeholder="Auto-generated">'
    +'<label>Description</label><textarea name="description" rows="2">'+esc(p.description||'')+'</textarea>'
    +'<label>Monthly Price ($)</label><input name="price_monthly" type="number" step="0.01" value="'+(p.price_monthly||'')+'">'
    +'<label>Yearly Price ($)</label><input name="price_yearly" type="number" step="0.01" value="'+(p.price_yearly||'')+'">'
    +'<label>Sort Order</label><input name="sort_order" type="number" value="'+(p.sort_order||0)+'">'
    +'</form>'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="savePlanForm(this,'+(edit?('\''+p.id+'\''):'null')+')">'+(edit?'Update':'Create')+'</button></div></div>';
  document.body.appendChild(overlay);
}

async function savePlanForm(btn,editId){
  const form=btn.closest('.modal').querySelector('#plan-form');
  const fd=new FormData(form);
  btn.textContent='Saving...';btn.disabled=true;
  try{
    const payload={
      name: fd.get('name'),
      slug: fd.get('slug')||undefined,
      description: fd.get('description')||undefined,
      price_monthly: parseFloat(fd.get('price_monthly'))||0,
      price_yearly: parseFloat(fd.get('price_yearly'))||0,
      sort_order: parseInt(fd.get('sort_order'))||0,
    };
    if(editId){
      await api('/admin/plans/'+editId,{method:'PUT',body:JSON.stringify(payload)});
      showToast('Plan updated');
    } else {
      await api('/admin/plans',{method:'POST',body:JSON.stringify(payload)});
      showToast('Plan created');
    }
    btn.closest('.modal-overlay').remove();
    renderPlans();
  }catch(e){showToast(e.message,'error');btn.textContent=editId?'Update':'Create';btn.disabled=false}
}

function editPlan(id){
  const p=plans.find(x=>x.id===id);
  if(p)showPlanForm(p);
}

/* ===== UTILITIES ===== */
function esc(s){if(!s)return'';const d=document.createElement('div');d.textContent=s;return d.innerHTML}
function showToast(msg,type){
  const el=document.createElement('div');
  el.className=type==='error'?'error':'success';
  el.textContent=msg;
  el.style.position='fixed';el.style.top='16px';el.style.right='16px';el.style.zIndex='200';el.style.maxWidth='400px';
  document.body.appendChild(el);
  setTimeout(()=>el.remove(),3000);
}

render();
</script>
</body>
</html>
